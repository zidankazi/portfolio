{
  "name": "portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs && node scripts/build-vercel.mjs",
    "start": "node dist/server.mjs",
    "lint": "npm run check && eslint scripts runtime src/*.mjs src/lib/*.mjs e2e *.mjs",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/manuscript*.ts",
    "build:gleam": "node scripts/gleam.mjs build --warnings-as-errors",
    "check:gleam": "node scripts/gleam.mjs format --check src && node scripts/gleam.mjs check",
    "test:gleam": "npm run build:gleam && node --test test/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.9",
    "colorthief": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.5",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "postcss": "^8.4.39",
    "sharp": "0.34.5",
    "tailwindcss": "^3.4.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
